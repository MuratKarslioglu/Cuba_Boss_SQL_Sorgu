# Temel model (HuggingFace model id veya yerel yol).
# Spec §13: model kaynak kodda sabitlenmez, buradan secilir.
BASE_MODEL=

# Egitilmis LoRA adapter yolu.
ADAPTER_PATH=./models/latest

# Uretilecek maksimum token sayisi (spec §15: V1 semasi icin 128-256 yeterli olmali).
MAX_NEW_TOKENS=192

# auto | cuda | mps | cpu   (spec §30)
DEVICE=auto

# auto | float32 | float16 | bfloat16
MODEL_DTYPE=auto

HOST=127.0.0.1
PORT=8000

# Spec §26: prompt icerigi varsayilan olarak loglanmaz.
# Yalnizca yerel gelistirmede acilir.
LOG_PROMPTS=false
LOG_LEVEL=INFO
